# --- Firebase Admin SDK (server-side only) ---
# Free Spark plan: Firebase console > Project settings > Service accounts > Generate new private key.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Wrap in quotes and keep the \n escapes from the downloaded JSON.
FIREBASE_PRIVATE_KEY=

# Admin login passphrase. Generate one: openssl rand -hex 32. If unset, /admin is disabled.
ADMIN_SECRET=

# ISR on-demand revalidation secret. Generate one: openssl rand -hex 32
REVALIDATION_SECRET=

# Public site URL
NEXT_PUBLIC_SITE_URL=https://rshekar.me

# Spotify now-playing (free): create an app at https://developer.spotify.com/dashboard, then
# obtain a refresh token with the user-read-currently-playing scope via the auth-code flow.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Anonymous ping webhook (e.g. a Discord/Slack webhook URL). Leave empty = pings disabled.
PING_WEBHOOK_URL=

# Google Drive share URL of your resume PDF (must be "Anyone with the link"); downloaded at build.
RESUME_SOURCE_URL=
